# =============================================================================
# VibeStock — Environment Variables Contract
# =============================================================================
# Copy this file to .env and populate all values before running docker compose.
#
# NEVER commit .env to source control.
# .env is listed in .gitignore.
#
# For production Oracle deployment, provide these values via:
#   - Oracle Vault
#   - OCI Instance Principal configuration
#   - Kubernetes Secrets (if OKE)
#   - Environment variable injection from your CI/CD pipeline
#
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=vibestock
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=vibestock

# --- Shared Database Connection String (used by all Cells) ---
DATABASE_CONNECTIONSTRING=Host=postgres;Database=vibestock;Username=vibestock;Password=REPLACE_WITH_STRONG_PASSWORD

# --- AI Provider (System.Cell) ---
AI_PROVIDER_APIKEY=REPLACE_WITH_AI_API_KEY
AI_PROVIDER_ENDPOINT=https://REPLACE_WITH_AI_PROVIDER_ENDPOINT
AI_PROVIDER_MODEL=REPLACE_WITH_MODEL_NAME

# --- Shopify (Bridge.Cell) ---
SHOPIFY_ACCESSTOKEN=REPLACE_WITH_SHOPIFY_ADMIN_API_TOKEN
SHOPIFY_BASEURL=https://REPLACE_WITH_STORE.myshopify.com

# --- mTLS Certificate Files (mounted as Docker secrets) ---
# Provide paths to PEM files on the Docker host.
# In production, use a certificate authority (e.g., step-ca, HashiCorp Vault PKI, SPIFFE/SPIRE).
MTLS_CERT_FILE=./certs/vibestock.crt
MTLS_KEY_FILE=./certs/vibestock.key
